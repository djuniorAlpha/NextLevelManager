# Postgres (usado pelo docker-compose.yml e pela DATABASE_URL abaixo)
POSTGRES_USER=nextlevel
POSTGRES_PASSWORD=nextlevel
POSTGRES_DB=nextlevel
POSTGRES_PORT=5432

DATABASE_URL="postgresql://nextlevel:nextlevel@localhost:5432/nextlevel?schema=public"

# App
PORT=3000
CORS_ORIGIN="http://localhost:3001"

# JWT (admin)
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="8h"

# Seed do primeiro AdminUser (owner)
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="troque-esta-senha"

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=""
# Opcional: token separado pra Preapproval/assinaturas, se for diferente do de cima
# (no sandbox de teste do Mercado Pago, cada app de teste só funciona pro produto
# declarado nela — Pagamentos vs Assinaturas — então costuma ser um token diferente
# em dev/teste. Em produção geralmente é a mesma credencial, pode deixar vazio.)
MERCADOPAGO_SUBSCRIPTIONS_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
# E-mail usado como payer nas cobranças Pix de clientes sem cadastro (pix_guest)
MERCADOPAGO_PAYER_EMAIL="cliente@lanhouse.com.br"
# Pra onde o Mercado Pago redireciona o cliente depois de autorizar uma assinatura (Preapproval).
# Precisa ser uma URL pública válida (não aceita localhost) — troque pelo domínio real do painel em produção.
MERCADOPAGO_BACK_URL="https://www.mercadopago.com.br"
