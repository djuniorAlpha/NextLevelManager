# Ambiente usado pelos testes e2e (pnpm test:e2e). Banco isolado do dev, nunca aponte
# isso para o banco de desenvolvimento: os testes truncam as tabelas antes de rodar.
DATABASE_URL="postgresql://nextlevel:nextlevel@localhost:5432/nextlevel_test?schema=public"

PORT=3000
CORS_ORIGIN="http://localhost:3001"

JWT_SECRET="test-secret"
JWT_EXPIRES_IN="8h"

SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="test-password"

MERCADOPAGO_ACCESS_TOKEN="test-token"
MERCADOPAGO_WEBHOOK_SECRET="test-webhook-secret"
MERCADOPAGO_PAYER_EMAIL="cliente@lanhouse.local"
